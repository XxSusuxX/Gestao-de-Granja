# =============================================================================
# GESTÃO DA GRANJA — Variáveis de Ambiente (Supabase + Vercel)
# =============================================================================
# Copie este arquivo para `.env` para rodar localmente com o seu banco Supabase,
# ou adicione a variável DATABASE_URL no painel da Vercel (Settings -> Environment Variables).
#
# Como pegar a DATABASE_URL no Supabase:
# 1. Acesse seu projeto no Supabase (https://supabase.com/dashboard)
# 2. Clique no botão "Connect" (no topo) -> aba "ORMs" (ou "Transaction pooler" / "Session pooler")
# 3. Copie a URI de conexão e substitua [YOUR-PASSWORD] pela senha do seu banco.
# =============================================================================

DATABASE_URL="postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Opcional: Caso utilize a integração automática da Vercel com o Supabase,
# a variável POSTGRES_URL é lida automaticamente pelo sistema!
# POSTGRES_URL=""
